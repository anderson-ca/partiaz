# Supabase
# Use the new key naming (sb_publishable_... / sb_secret_...).
# Legacy anon / service_role keys still work until end of 2026 but are deprecated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Twilio — programmatic SMS sends for the invite flow (NOT the Twilio
# Verify Service used by Supabase Auth for OTPs — that's separate and lives
# in the Supabase dashboard, not here).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Resend (added later)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Unsplash (added later)
UNSPLASH_ACCESS_KEY=

# Giphy — used by the GIFs tab in the cover picker (server-routed via
# app/actions/giphy.ts). Free tier, instant approval at developers.giphy.com.
GIPHY_API_KEY=

# Site — NON-public on purpose. NEXT_PUBLIC_* vars get inlined into the
# bundle at build time, so dashboard changes wouldn't take effect on Vercel
# without a redeploy. Plain SITE_URL is read at runtime via process.env.
SITE_URL=http://localhost:3000

# Cron
CRON_SECRET=
